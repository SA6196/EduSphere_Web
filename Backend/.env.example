# Copy to .env and fill in unique local values. Do not commit or send .env.
ODBC_DSN=EduSphereOracle
ODBC_USER=EDUSPHERE_APP
ODBC_PASSWORD=REPLACE_WITH_APP_USER_PASSWORD
ODBC_CONNECTION_STRING=
ORACLE_SCHEMA=EDUSPHERE_OWNER
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Tuning: one Oracle session per long-lived worker thread, recycled when idle.
ODBC_CONNECTION_MAX_IDLE_SECONDS=300
ODBC_CONNECTION_MAX_AGE_SECONDS=1800
